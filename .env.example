# c-ssl 环境变量样例
# 复制为 .env 后填入真实值。.env 已被 .gitignore 忽略。
# 生产环境请通过密钥管理系统注入，不要使用本文件中的任何示例值。

# ── 应用 ──────────────────────────────────────────
APP_ENV=development
APP_PORT=8080
APP_BASE_URL=http://localhost:8080

# ── MySQL ─────────────────────────────────────────
# 格式：user:password@tcp(host:port)/dbname?charset=utf8mb4&parseTime=true&loc=Local
# 本地执行 make db-create 会自动建库建用户，并打印可用的 DSN
MYSQL_DSN=
MYSQL_TEST_DSN=

# ── Redis ─────────────────────────────────────────
# 注意：本地实例可能被多个项目共用，务必使用独立 db index，避免键冲突
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=
REDIS_DB=1

# ── 认证 ──────────────────────────────────────────
# JWT_SECRET：生产环境必须至少 32 位随机串，启动时会校验长度
# ACCESS_TTL 决定访问令牌的失效延迟；REFRESH_TTL 是刷新令牌与登录状态的保持时长
JWT_SECRET=
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=168h

# 是否采信 X-Forwarded-For 判定客户端 IP。
# 默认 false：该头可被客户端伪造，直接采信会让登录限流形同虚设。
# 只有服务确实部署在可信反向代理之后时才设为 true。
TRUST_PROXY=false

# ── FoxSSL 上游（仅服务端可读，禁止进入前端构建产物与日志）──
FOXSSL_BASE_URL=
FOXSSL_API_KEY=
FOXSSL_WEBHOOK_SECRET=

# ── 支付渠道（同上，仅服务端）────────────────────
PAYMENT_PROVIDER=
PAYMENT_APP_ID=
PAYMENT_PRIVATE_KEY=
PAYMENT_WEBHOOK_SECRET=

# ── 邮件 ──────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASSWORD=

# ── 日志 ──────────────────────────────────────────
LOG_LEVEL=info
